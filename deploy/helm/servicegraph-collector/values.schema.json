{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string", "maxLength": 40},
    "image": {"$ref": "#/$defs/image"},
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "serviceAccount": {"type": "object"},
    "router": {
      "type": "object",
      "required": ["replicaCount", "service", "resources", "queueSize"],
      "properties": {
        "replicaCount": {"const": 2},
        "service": {"type": "object"},
        "resources": {"type": "object"},
        "queueSize": {"type": "integer", "minimum": 1},
        "podAnnotations": {"type": "object"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "replicaCount", "serviceGraph", "resources"],
      "properties": {
        "mode": {"enum": ["singleWriter", "horizontal"]},
        "replicaCount": {"type": "integer", "minimum": 1},
        "serviceGraph": {"type": "object"},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "singleWriter"}},
            "required": ["mode"]
          },
          "then": {"properties": {"replicaCount": {"const": 1}}}
        },
        {
          "if": {
            "properties": {"mode": {"const": "horizontal"}},
            "required": ["mode"]
          },
          "then": {"properties": {"replicaCount": {"minimum": 2}}}
        }
      ]
    },
    "streamContract": {
      "type": "object",
      "required": ["kafka", "topics"],
      "properties": {
        "kafka": {
          "type": "object",
          "required": ["brokers", "security"],
          "properties": {
            "brokers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
            "security": {
              "type": "object",
              "required": ["protocol", "existingSecret"],
              "properties": {
                "protocol": {"enum": ["PLAINTEXT", "SASL_PLAINTEXT", "SASL_SSL"]},
                "saslMechanism": {"const": "SCRAM-SHA-256"},
                "existingSecret": {"type": "string"},
                "usernameKey": {"type": "string", "minLength": 1},
                "passwordKey": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "topics": {
          "type": "object",
          "required": ["servicegraphMetrics"],
          "properties": {
            "servicegraphMetrics": {"type": "string", "minLength": 1},
            "entityEvents": {"type": "string", "minLength": 1},
            "rootSpans": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "entityEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "rootSpanDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "markerAttribute"],
      "properties": {
        "enabled": {"type": "boolean"},
        "markerAttribute": {"type": "string", "minLength": 1}
      }
    },
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "required": ["image", "router", "backend", "streamContract", "entityEvents", "rootSpanDiscovery"],
  "allOf": [
    {
      "if": {
        "properties": {
          "rootSpanDiscovery": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        },
        "required": ["rootSpanDiscovery"]
      },
      "then": {
        "properties": {
          "streamContract": {
            "properties": {
              "topics": {"required": ["rootSpans"]}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
